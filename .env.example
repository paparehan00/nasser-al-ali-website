# Copy this file to `.env` (same folder) and fill in the values.
# `.env` is gitignored and never shipped.

# --- Client build-time variables (Vite) ---------------------------------------
# These are baked into the frontend bundle at build time. Do NOT put secrets here.

# AI chat assistant: URL of the deployed Cloudflare Worker.
# Leave blank until the worker is deployed.
VITE_CHAT_API_URL=

# --- Server: auth & session ---------------------------------------------------
# Required. Generate a strong random value: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Optional (default 43200 = 12 h)
JWT_TTL_SECONDS=43200

# --- Server: database ---------------------------------------------------------
# Optional. Defaults to ./data/app.db relative to server/
DB_PATH=

# --- Server: admin seed credentials ------------------------------------------
# Only used on first boot to create the initial admin user.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# --- Server: email (Nodemailer + Gmail SMTP) ----------------------------------
# The Gmail account must have 2-Step Verification enabled and use an App Password.
# To generate an App Password: Google Account → Security → 2-Step Verification → App Passwords.
# Never commit the real password.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=leadsnasseralalienterprises@gmail.com
SMTP_PASS=

# Display name shown in the "From" field of outgoing emails.
MAIL_FROM_NAME=Nasser Al Ali Enterprises

# Address shown in the "From" field. Leave blank to use SMTP_USER (Gmail).
# When sending through a relay like Brevo, set this to the company address,
# e.g. info@nasseralalienterprises.com (the domain must be verified there).
MAIL_FROM_EMAIL=

# Admin inbox: receives a notification for every new consultation booking.
NOTIFY_EMAIL=info@nasseralalienterprises.com

# Where a customer's reply goes when they hit Reply on a confirmation email.
# Defaults to NOTIFY_EMAIL. Set this only if replies should go somewhere else
# than the inbox that receives the booking alerts.
MAIL_REPLY_TO=

# NOTE on MAIL_FROM_EMAIL above: leave it blank while sending through Gmail.
# The domain's SPF record is `v=spf1 include:spf.protection.outlook.com -all`,
# which authorises Microsoft only, so Gmail may not send as @the domain. Once a
# relay such as Brevo is set up and the domain is verified there, set
# MAIL_FROM_EMAIL=info@nasseralalienterprises.com and point SMTP_* at Brevo --
# no code change is needed, every send path reads that one variable.
# The SPF record must then keep Microsoft as well:
#   v=spf1 include:spf.protection.outlook.com include:spf.brevo.com -all

# --- Server: AI translation (Groq) -------------------------------------------
# Used by the admin CMS to auto-translate EN → AR on save.
# Get a free key at console.groq.com.
GROQ_API_KEY=

# --- Server: off-site database backups ----------------------------------------
# `npm run server:backup` writes into the same volume as the live database, so
# on its own it does not survive losing that volume. Set at least ONE of the
# targets below and the backup is copied off-platform on every run.
#
# Option A - S3-compatible object storage (Cloudflare R2 free tier is 10 GB).
# For R2: endpoint is https://<account-id>.r2.cloudflarestorage.com, region "auto".
BACKUP_S3_ENDPOINT=
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=auto
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
BACKUP_S3_PREFIX=naa-backups

# Option B - emailed attachment. Simplest to set up: reuses the SMTP settings
# above, no new account needed. The database is ~120 KB.
BACKUP_EMAIL_TO=

# --- Server: CORS origins -----------------------------------------------------
# Comma-separated list of allowed client origins (production domain goes here).
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174,http://localhost:4173
